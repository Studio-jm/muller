# Local development — copy to `.env` and adjust if needed.
# These values match docker-compose.yml. Do not use them in production.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres (docker compose service `postgres`)
DATABASE_URL=postgresql://foyer:foyer@localhost:5432/foyer

# MinIO / S3-compatible storage (docker compose service `minio`)
# API: http://localhost:9000  —  console: http://localhost:9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=foyer
S3_ACCESS_KEY=foyer
S3_SECRET_KEY=foyerdevpassword
S3_FORCE_PATH_STYLE=true
